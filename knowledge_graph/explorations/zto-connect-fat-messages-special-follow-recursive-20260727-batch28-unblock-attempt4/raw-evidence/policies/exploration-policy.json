{
  "schemaVersion": "1.0.0",
  "recordType": "AppUiExplorationPolicy",
  "policyId": "zto-connect-fat-messages-special-follow-recursive-20260727-batch28-unblock-attempt4:policy",
  "sourceScopeHash": "sha256:04a96c81350e16799d66da73e9494c5178ae71dabbb014a55ca1ed0b87bb4e47",
  "applicationKey": "zto.connect",
  "packageId": "com.zto.connect.fat",
  "executionFramework": "midscene",
  "maxDepth": 1,
  "maxActions": 3,
  "allowedRiskLevels": [
    "low",
    "safe"
  ],
  "allowedTargetScopes": [
    "temporary_state_control"
  ],
  "allowedTapRegions": [
    {
      "key": "account-security-close-region",
      "space": "current_display_px",
      "rect": {
        "x": 1010,
        "y": 120,
        "width": 120,
        "height": 150
      },
      "purpose": "账号安全检查页面右上角关闭 X 的局部区域。"
    }
  ],
  "entryOnly": [
    "security.defer_login",
    "security.process_now"
  ],
  "forbiddenTargetPatterns": [
    "编辑",
    "删除",
    "发送",
    "提交",
    "支付",
    "签到",
    "抽奖",
    "分享",
    "权限",
    "退出登录",
    "去处理",
    "暂不处理"
  ],
  "allowedSideEffects": [
    "navigation_history",
    "temporary_display_state"
  ],
  "prohibitedSideEffects": [
    "account_change",
    "attendance_check_in",
    "data_delete",
    "external_share",
    "form_submit",
    "logout",
    "lottery_participation",
    "message_send",
    "payment",
    "permission_change",
    "persistent_setting_change"
  ],
  "credentialsPolicy": "require_user_intervention",
  "deviceGates": {
    "requireUnlocked": true,
    "requireNoExternalOverlay": true,
    "requireFreshVisualInspection": true
  },
  "defaultWaitMs": 2500,
  "capture": {
    "stabilitySampleCount": 3,
    "stabilityIntervalMs": 500,
    "visualDistanceThreshold": 0.02,
    "requireForegroundVerification": true,
    "semanticRecognition": {
      "provider": "midscene",
      "required": true,
      "persistDecisionEvidence": true,
      "failurePolicy": "abort"
    }
  },
  "scope": {
    "mode": "recursive_feature",
    "maxDepth": 1,
    "maxActions": 3,
    "include": [
      "common.account_security_check"
    ],
    "exclude": [
      "common.account_security_check.details",
      "external_application",
      "system_credentials"
    ],
    "entryOnly": [
      "security.process_now",
      "security.defer_login"
    ],
    "stopAt": [
      "zto.main.after_security_check"
    ],
    "unknownControlPolicy": "inspect_all_activate_safe",
    "traversal": "breadth_first",
    "deduplicateBy": "semantic_presentation_signature",
    "requireQueueExhaustion": true,
    "viewportOnly": false
  }
}
