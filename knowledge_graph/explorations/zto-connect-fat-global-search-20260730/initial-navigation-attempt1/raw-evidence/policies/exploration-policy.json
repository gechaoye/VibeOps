{
  "schemaVersion": "2.0.0",
  "recordType": "AppUiExplorationPolicy",
  "policyId": "zto-connect-fat-global-search-20260730:initial-navigation",
  "sourceScopeHash": "sha256:4623fe78d898f9735ec796700b54a8faf4826aae4e121ae508162af6757b8311",
  "applicationKey": "zto.connect",
  "packageId": "com.zto.connect.fat",
  "executionFramework": "midscene",
  "maxDepth": 3,
  "maxActions": 2,
  "allowedRiskLevels": [
    "safe",
    "low"
  ],
  "allowedTargetScopes": [
    "shared_navigation",
    "feature_entry",
    "page_content",
    "page_navigation",
    "scroll_region",
    "temporary_state_control"
  ],
  "allowedTapRegions": [
    {
      "key": "app-visible-surface",
      "space": "current_display_px",
      "rect": {
        "x": 0,
        "y": 0,
        "width": 1152,
        "height": 2376
      },
      "purpose": "仅限制 Midscene 实时定位结果位于当前应用可见范围；不作为坐标定位或点击依据。"
    }
  ],
  "entryOnly": [],
  "forbiddenTargetPatterns": [
    "编辑",
    "删除",
    "发送",
    "提交",
    "支付",
    "签到",
    "抽奖",
    "分享",
    "权限",
    "退出登录"
  ],
  "allowedSideEffects": [
    "navigation_history",
    "temporary_display_state",
    "viewport_scroll"
  ],
  "prohibitedSideEffects": [
    "account_change",
    "attendance_check_in",
    "data_delete",
    "external_share",
    "form_submit",
    "logout",
    "lottery_participation",
    "message_send",
    "payment",
    "permission_change",
    "persistent_setting_change"
  ],
  "credentialsPolicy": "require_user_intervention",
  "deviceGates": {
    "requireUnlocked": true,
    "requireNoExternalOverlay": true,
    "requireFreshVisualInspection": true
  },
  "defaultWaitMs": 1800,
  "capture": {
    "stabilitySampleCount": 3,
    "stabilityIntervalMs": 500,
    "visualDistanceThreshold": 0.02,
    "requireForegroundVerification": true,
    "semanticRecognition": {
      "provider": "midscene",
      "required": true,
      "persistDecisionEvidence": true,
      "failurePolicy": "abort"
    }
  },
  "scope": {
    "mode": "recursive_feature",
    "maxDepth": 3,
    "maxActions": 2,
    "include": [
      "messages.root",
      "global_search.root"
    ],
    "exclude": [
      "external_application",
      "system_credentials"
    ],
    "entryOnly": [],
    "stopAt": [],
    "unknownControlPolicy": "inspect_all_activate_safe",
    "traversal": "breadth_first",
    "deduplicateBy": "semantic_presentation_signature",
    "requireQueueExhaustion": false,
    "viewportOnly": false
  }
}
