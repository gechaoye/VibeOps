{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vibeops-model.schema.json",
  "title": "VibeOps Project Graph 1.0 Model Definition",
  "type": "object",
  "properties": {
    "modelVersion": { "type": "string", "minLength": 1 },
    "baseModelVersion": { "type": "string", "minLength": 1 },
    "projectRef": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "entityTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["label"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "group": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "relationTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sourceTypes", "targetTypes"],
        "properties": {
          "sourceTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "targetTypes": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "label": { "type": "string" },
          "description": { "type": "string" },
          "constraints": { "type": "object" }
        },
        "additionalProperties": true
      }
    },
    "optionSets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "options": { "$ref": "#/$defs/options" },
          "addOptions": { "$ref": "#/$defs/options" }
        },
        "additionalProperties": true
      }
    },
    "fields": {
      "type": "array",
      "items": { "$ref": "#/$defs/field" }
    }
  },
  "anyOf": [
    { "required": ["modelVersion", "entityTypes", "relationTypes", "fields"] },
    { "required": ["projectRef", "baseModelVersion", "modelVersion"] }
  ],
  "additionalProperties": false,
  "$defs": {
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["value", "label"],
        "properties": {
          "value": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["active", "inactive"] }
        },
        "additionalProperties": false
      }
    },
    "field": {
      "type": "object",
      "required": ["key", "appliesTo", "valueType"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "example": { "type": "string" },
        "appliesTo": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "valueType": {
          "enum": [
            "string", "text", "integer", "number", "boolean", "date", "datetime",
            "option", "multi_option", "entity_ref", "entity_ref_list", "object", "object_list"
          ]
        },
        "required": { "type": "boolean" },
        "defaultValue": {},
        "optionSetRef": { "type": "string" },
        "allowCustomOptions": { "type": "boolean" },
        "searchable": { "type": "boolean" },
        "itemFields": {
          "type": "array",
          "items": { "$ref": "#/$defs/itemField" }
        },
        "ui": { "type": "object" }
      },
      "additionalProperties": false
    },
    "itemField": {
      "type": "object",
      "required": ["key", "valueType"],
      "properties": {
        "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
        "label": { "type": "string" },
        "valueType": {
          "enum": [
            "string", "text", "integer", "number", "boolean", "date", "datetime",
            "option", "multi_option", "entity_ref", "entity_ref_list", "object", "object_list"
          ]
        },
        "required": { "type": "boolean" },
        "defaultValue": {},
        "optionSetRef": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
