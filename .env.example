# Model gateways and assignments are managed in the Workbench SQLite database.
# UIKG_WORKBENCH_DATA_DIR="apps/uikg-workbench/.data"
# WORKBENCH_PORT="5800"

# OCR bbox refinement: auto | apple-vision | paddleocr | disabled
# UIKG_OCR_ENGINE="auto"
# UIKG_OCR_PYTHON="/absolute/path/to/python"
# UIKG_OCR_TIMEOUT_MS="120000"
# UIKG_PADDLE_OCR_LANG="ch"
# UIKG_PADDLE_OCR_DEVICE="gpu:0"
