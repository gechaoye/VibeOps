# Reviewer model used to check Scout candidates.
MIDSCENE_MODEL_BASE_URL=https://api.openai.com/v1
MIDSCENE_MODEL_API_KEY=
MIDSCENE_MODEL_NAME=gpt-4o-mini
MIDSCENE_MODEL_FAMILY=gpt-4o
MIDSCENE_MODEL_TIMEOUT=120000
MIDSCENE_MODEL_TEMPERATURE=0

# Read-only full-frame model used by UIKG Workbench.
MIDSCENE_SCOUT_MODEL_BASE_URL=https://api.openai.com/v1
MIDSCENE_SCOUT_MODEL_API_KEY=
MIDSCENE_SCOUT_MODEL_NAME=gpt-4o-mini
MIDSCENE_SCOUT_MODEL_FAMILY=gpt-4o
MIDSCENE_SCOUT_MODEL_TIMEOUT=180000
MIDSCENE_SCOUT_MODEL_TEMPERATURE=0
MIDSCENE_SCOUT_MODEL_REASONING_ENABLED=false
